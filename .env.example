# ── 超级大脑 v2.1 环境变量示例（复制为 .env，禁止提交 .env）──────
# 配置前缀见 config.py（STORAGE_ / MODEL_ / RECALL_ / PLAST_ / TIER_ / SYNC_ / GW_ / BRAIN_）

BRAIN_LOG_LEVEL=INFO

# 设备身份与同步（SYNC_ 前缀）
SYNC_DEVICE_ID=dev-$(hostname)
SYNC_REPO_URL=
SYNC_SYNC_INTERVAL_SEC=300
SYNC_USE_AGE_ENCRYPT=false

# GitHub PAT：只放环境变量/钥匙串，禁止入库、禁止写入事件
GITHUB_PAT=

# 网关（GW_ 前缀）
GW_MCP_PORT=8765
GW_HTTP_PORT=8766
GW_MCP_TOKEN_SECRET=
GW_DEFAULT_RATE_LIMIT=60

# 算力层（MODEL_ 前缀）
MODEL_USE_CUDA=false
MODEL_LLM_GPU_LAYERS=-1
